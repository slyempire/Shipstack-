# Google Maps Integration
GOOGLE_MAPS_PLATFORM_KEY=

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# M-Pesa Integration (Daraja API)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# KRA eTIMS Integration
ETIMS_API_KEY=

# Frappe Backend Configuration (Server-Side Only)
FRAPPE_BASE_URL=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Security Configuration
# SECURITY_SECRET: Must be 32+ chars. NEVER expose to client as VITE_
SECURITY_SECRET=
APP_URL=

# AI & Caching
GEMINI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Demo authentication (LOCAL/DEV ONLY — leave blank in production)
# When VITE_ENABLE_DEMO_AUTH=true, the seeded demo accounts can sign in with
# their seeded password. When ENABLE_DEMO_AUTH=true, the server accepts the
# `demo.` session tokens those logins issue. Real Supabase auth always works
# regardless; these only toggle the demo path. A failed real login NEVER falls
# back to a demo identity.
VITE_ENABLE_DEMO_AUTH=
ENABLE_DEMO_AUTH=
