# Maps: rendered with MapLibre + OpenFreeMap tiles — no API key required.

# M-Pesa Integration (Safaricom Daraja API)
# MPESA_ENV: "sandbox" or "production". When credentials are missing in
# development, the STK Push endpoint falls back to a simulated response.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Publicly reachable URL Daraja will POST payment results to, e.g. https://app.example.com/api/mpesa/callback
MPESA_CALLBACK_URL=

# KRA eTIMS Integration
ETIMS_BASE_URL=
ETIMS_API_KEY=
ETIMS_DEVICE_SERIAL=

# Frappe Backend Configuration (Server-Side Only)
FRAPPE_BASE_URL=
FRAPPE_SITE=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Security Configuration
# SECURITY_SECRET: Must be 32+ chars. NEVER expose to client as VITE_
SECURITY_SECRET=
# INTERNAL_API_SECRET: Required in production. Protects internal-only routes
# (cache admin, service-to-service calls). Must differ from SECURITY_SECRET.
INTERNAL_API_SECRET=
APP_URL=

# Marketing analytics (optional — GA4 measurement ID, e.g. G-XXXXXXXXXX).
# Client-safe (VITE_ prefix is intentional; measurement IDs are public).
# Loads ONLY on marketing pages and ONLY after cookie-banner consent.
VITE_GA_MEASUREMENT_ID=

# Error Monitoring (optional — leave empty to disable)
# SENTRY_DSN: server-side (Node). VITE_SENTRY_DSN: browser bundle — use a
# separate Sentry project for the client. Both are safe to expose only in
# the sense that DSNs are write-only keys.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Offsite backup sync (optional — leave BACKUP_S3_BUCKET empty to disable).
# Any S3-compatible store works: AWS S3, Cloudflare R2, Backblaze B2, MinIO.
# The backup-sync service copies ./backups to the bucket every 6 hours.
BACKUP_S3_BUCKET=
BACKUP_S3_PROVIDER=AWS
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto

# AI & Caching (Server-Side Only — never expose GEMINI_API_KEY as VITE_)
GEMINI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
